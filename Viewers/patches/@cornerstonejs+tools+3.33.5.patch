index 0000000..3c89ba3
--- /dev/null
+++ b/node_modules/@cornerstonejs/tools/dist/esm/tools/displayTools/Labelmap/disposeStackLabelmapActors.js
@@ -0,0 +1,39 @@
+function safeDelete(vtkObject) {
+    if (!vtkObject || vtkObject.isDeleted?.()) {
+        return;
+    }
+    try {
+        vtkObject.delete?.();
+    }
+    catch (error) {
+        console.debug('Unable to dispose stack labelmap VTK resource', error);
+    }
+}
+export function disposeStackLabelmapActors(viewport, actorEntries) {
+    const uniqueEntries = [...new Map((actorEntries || [])
+            .filter((actorEntry) => actorEntry?.uid)
+            .map((actorEntry) => [actorEntry.uid, actorEntry])).values()];
+    if (!uniqueEntries.length) {
+        return;
+    }
+    viewport.removeActors(uniqueEntries.map((actorEntry) => actorEntry.uid));
+    uniqueEntries.forEach((actorEntry) => {
+        const actor = actorEntry.actor;
+        const mapper = actor?.getMapper?.();
+        const imageData = mapper?.getInputData?.();
+        try {
+            mapper?.setInputData?.(null);
+        }
+        catch (_error) {
+        }
+        try {
+            actor?.setMapper?.(null);
+        }
+        catch (_error) {
+        }
+        safeDelete(imageData);
+        safeDelete(mapper);
+        safeDelete(actor);
+    });
+}
+export default disposeStackLabelmapActors;
