COPY extensions/measurement-tracking/package.json extensions/measurement-tracking/
COPY extensions/test-extension/package.json extensions/test-extension/
COPY extensions/tmtv/package.json extensions/tmtv/
COPY modes/basic-dev-mode/package.json modes/basic-dev-mode/
COPY modes/basic-test-mode/package.json modes/basic-test-mode/
COPY modes/longitudinal/package.json modes/longitudinal/
COPY modes/nifti/package.json modes/nifti/
COPY modes/microscopy/package.json modes/microscopy/
COPY modes/preclinical-4d/package.json modes/preclinical-4d/
COPY modes/segmentation/package.json modes/segmentation/
COPY modes/tmtv/package.json modes/tmtv/
COPY platform/app/package.json platform/app/
COPY platform/cli/package.json platform/cli/
COPY platform/core/package.json platform/core/
COPY platform/i18n/package.json platform/i18n/
COPY platform/ui-next/package.json platform/ui-next/
COPY platform/ui/package.json platform/ui/
COPY addOns/package.json addOns/
COPY addOns/externals/devDependencies/package.json addOns/externals/devDependencies/
COPY addOns/externals/dicom-microscopy-viewer/package.json addOns/externals/dicom-microscopy-viewer/

# Install node dependencies (cached unless package.json/yarn.lock change).
# Yarn 1 can leave an incomplete global cache entry when a proxied download is
# interrupted (for example a missing .yarn-metadata.json for an optional esbuild
# platform package). Use one network request at a time and retry from a clean
# cache so transient proxy failures do not poison the image build.
RUN yarn config set workspaces-experimental true \
    && yarn config set network-timeout 600000
RUN set -eux; \
    yarn cache clean --all; \
    attempt=1; \
    while [ "$attempt" -le 3 ]; do \
      if yarn install --frozen-lockfile --network-concurrency 1 --network-timeout 600000; then \
        break; \
      fi; \
      if [ "$attempt" -eq 3 ]; then \
        exit 1; \
      fi; \
      attempt=$((attempt + 1)); \
      echo "yarn install failed; clearing cache before retry $attempt/3"; \
      yarn cache clean --all; \
      sleep 5; \
    done

# Now copy the full source code
COPY ./ /usr/src/app/

# Fail the production image build if the pinned Cornerstone memory patch was not applied.
RUN yarn run verify:cornerstone-stack-labelmap-patch

# To change color of negative prompts
RUN rm -rf /usr/src/app/node_modules/@cornerstonejs/tools/dist/esm/tools/base/AnnotationTool.js

# Add annotation from the given indices plus the detail rendering setup for each prompt type
RUN rm -rf /usr/src/app/node_modules/@cornerstonejs/tools/dist/esm/tools/annotation/ProbeTool.js
RUN rm -rf /usr/src/app/node_modules/@cornerstonejs/tools/dist/esm/tools/annotation/RectangleROITool.js
RUN rm -rf /usr/src/app/node_modules/@cornerstonejs/tools/dist/esm/tools/annotation/PlanarFreehandROITool.js
