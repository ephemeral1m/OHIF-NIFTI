# Stage 1: Build the application
FROM node:20.18.1-slim as builder

# Setup the working directory
RUN mkdir /usr/src/app
WORKDIR /usr/src/app

# Install dependencies
# apt-get update is combined with apt-get install to avoid using outdated packages
RUN apt-get update && apt-get install -y build-essential python3
RUN npm install -g lerna@7.4.2

# Copy dependency-definition files first so yarn install is cached
# unless dependencies actually change
COPY package.json yarn.lock preinstall.js ./
COPY patches/ patches/
COPY .scripts/install-stack-labelmap-update.js .scripts/stack-labelmap-update.js .scripts/install-interpolation-runtime.js .scripts/
