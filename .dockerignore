# Large directories that are volume-mounted at runtime (shadowed in container)
monai-label/checkpoints/
monai-label/hf_cache/
monai-label/nifti_segs/

# Git & development
.git/
.github/
.vscode/
.idea/
release-artifacts/

# Frontend build artifacts (separate container)
Viewers/node_modules/
Viewers/.yarn/
Viewers/platform/app/dist/
Viewers/platform/app/.recipes/

# Sample data (not needed for runtime)
sample-data/
sample_data/

# Documentation & meta files
*.md
docs/
USAGE_MANUAL.md

# Python caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# OS files
.DS_Store
Thumbs.db

# Logs & tmp
*.log
*.tmp
tmp/
logs/
